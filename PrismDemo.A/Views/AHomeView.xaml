<UserControl x:Class="PrismDemo.A.Views.AHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <StackPanel Margin="16">
        <TextBlock FontSize="16" FontWeight="Bold" Text="模块 A（框架演示，假数据）" Margin="0,0,0,10" />

        <TextBlock Text="配置（读自 a.config.json）：" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding SampleUpper, StringFormat='上限: {0:F1}'}" />
        <TextBlock Text="{Binding SampleLower, StringFormat='下限: {0:F1}'}" />
        <TextBlock Text="{Binding RefreshSeconds, StringFormat='刷新周期: {0} 秒'}" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="启动服务" Width="90" Margin="0,0,8,0" Command="{Binding StartCommand}" />
            <Button Content="停止服务" Width="90" Command="{Binding StopCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding LatestValue, StringFormat='最新采样值: {0:F2}'}" FontWeight="Bold" Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Width="100" />
                        <TextBlock Text="{Binding Value, StringFormat='{}{0:F2}'}" Width="80" />
                        <TextBlock Text="{Binding Status}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>