<UserControl x:Class="PrismDemo.A.Views.ChartPage4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismDemo.A.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:PrismDemo.Core.Converters;assembly=PrismDemo.Core"
             xmlns:core="clr-namespace:PrismDemo.Core.Services;assembly=PrismDemo.Core"
             xmlns:controls="clr-namespace:PrismDemo.Core.Controls;assembly=PrismDemo.Core"
             xmlns:lvc2="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="960">
    <UserControl.Resources>
        <converters:BoolConverter x:Key="BoolConverter"/>
        <converters:ChangeRateTextConverter x:Key="ChangeRateTextConverter"/>
        <converters:ChangeRateColorConverter x:Key="ChangeRateColorConverter"/>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.ColumnSpan="4" Content="查看详细历史曲线" Command="{Binding OpenHistoryChartCmd}" Height="20"
                                Background="#607D8B" Foreground="White" FontWeight="Bold" FontSize="10"
                                BorderThickness="0" Cursor="Hand" 
                                VerticalAlignment="Top"  HorizontalAlignment="Right"
                                Margin="9,5,5,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Border Grid.Row="1" Grid.Column="0" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="4号控制点智能控制" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <controls:LedIndicator Grid.Row="1"
                                                       IsAuto="{Binding CurrentData[IsAutoMainA_2_4].Value, Converter={StaticResource IntToBoolConverter}}"
                                                       Command="{Binding ToggleAutoCmd}"
                                                       Width="40" Height="40"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="合规率" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding ComplianceRate, StringFormat={}{0}%}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding ComplianceRateChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding ComplianceRateChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Margin="5" Padding="12,8"
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" CornerRadius="5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="原水浊度" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#FF9800"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding CurrentData[InTurbidity_2].Value, StringFormat={}{0:F2}Turbidity}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding RawWaterTurbidityChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding RawWaterTurbidityChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="沉后水浊度" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#00BCD4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding CurrentData[SettledTurbidity_2_2_2].Value, StringFormat={}{0:F2}Turbidity}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding SettledWaterTurbidityChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding SettledWaterTurbidityChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="沉前水流量" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding CurrentData[FrontFlow_2_2_2].Value, StringFormat={}{0:F2}}"/>
                                <TextBlock Grid.Row="2" 
                                        Text="m³/h" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="智能药量" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding CurrentData[PredictMainA_2_4].Value, StringFormat={}{0:F2}}"/>
                                <TextBlock Grid.Row="2" 
                                        Text="L/h" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="泵后药流量" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding CurrentData[MainABack_2_6].Value, StringFormat={}{0:F2}}"/>
                                <TextBlock Grid.Row="2" 
                                        Text="L/h" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="智能投加率" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding CurrentData[PredictMainAUnitRate_2_4].Value, StringFormat={}{0:F2}}"/>
                                <TextBlock Grid.Row="2" 
                                        Text="mg/L" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="沉后水浊度目标值" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="12" FontWeight="Bold" Foreground="#388E3C" 
                                        core:WriteableBehavior.IsEnabled="True" 
                                        core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                        core:WriteableBehavior.ConnectData="{Binding CurrentData[SettledTurbidityTarget_2_4]}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource BoolConverter}">
                                            <Binding Path="CurrentData[SettledTurbidityTarget_2_4].Value"/>
                                            <Binding Path="CurrentData[SettledTurbidityTarget_2_4].Type"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="2" 
                                        Text="Turbidity" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="人工修正值" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="14" FontWeight="Bold" 
                                        Foreground="#388E3C" 
                                        core:WriteableBehavior.IsEnabled="True" 
                                        core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                        core:WriteableBehavior.ConnectData="{Binding CurrentData[AUnitRateRatio_2_4]}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource BoolConverter}">
                                            <Binding Path="CurrentData[AUnitRateRatio_2_4].Value"/>
                                            <Binding Path="CurrentData[AUnitRateRatio_2_4].Type"/>
                                        </MultiBinding>
                                    </TextBlock.Text></TextBlock>
                                <TextBlock Grid.Row="2" 
                                        Text=" " 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="投加率上限" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="14" 
                                        FontWeight="Bold" Foreground="#388E3C" 
                                        core:WriteableBehavior.IsEnabled="True" 
                                        core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                        core:WriteableBehavior.ConnectData="{Binding CurrentData[AUnitRateUpper_2_4]}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource BoolConverter}">
                                            <Binding Path="CurrentData[AUnitRateUpper_2_4].Value"/>
                                            <Binding Path="CurrentData[AUnitRateUpper_2_4].Type"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="2" 
                                        Text="mg/L" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3"  BorderBrush="Black" BorderThickness="0.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="投加率下限" FontSize="13" Foreground="#888"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="14" 
                                        FontWeight="Bold" Foreground="#388E3C" 
                                        core:WriteableBehavior.IsEnabled="True" 
                                        core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                        core:WriteableBehavior.ConnectData="{Binding CurrentData[AUnitRateLower_2_4]}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource BoolConverter}">
                                            <Binding Path="CurrentData[AUnitRateLower_2_4].Value"/>
                                            <Binding Path="CurrentData[AUnitRateLower_2_4].Type"/>
                                        </MultiBinding>
                                    </TextBlock.Text></TextBlock>
                                <TextBlock Grid.Row="2" 
                                        Text="mg/L" 
                                        FontSize="13" 
                                        Foreground="#888"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60*"/>
                    <RowDefinition Height="40*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0.5">
                    <Button Content="打开絮体视频"
                            Command="{Binding OpenFlocCmd}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="120" Height="40"
                            FontSize="14"
                            Cursor="Hand"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                    <lvc2:CartesianChart Grid.Row="1"
                                         Series="{Binding OutletTurbiditySeries}"
                                         XAxes="{Binding OutletTurbidityXAxes}"
                                         YAxes="{Binding OutletTurbidityYAxes}"
                                         LegendPosition="Top"
                                         TooltipPosition="Top" 
                                         Margin="2"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border  Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                <lvc2:CartesianChart Grid.Column="0"
                                 Series="{Binding SettledTurbiditySeries}"
                                 XAxes="{Binding SettledTurbidityXAxes}"
                                 YAxes="{Binding SettledTurbidityYAxes}"
                                 LegendPosition="Top"
                                 TooltipPosition="Top" 
                                 Margin="2"/>
            </Border>
            <Border  Grid.Column="1"  BorderBrush="Black" BorderThickness="0.5">
                <lvc2:CartesianChart Grid.Column="1"
                                     Series="{Binding RawWaterTurbiditySeries}"
                                     XAxes="{Binding RawWaterTurbidityXAxes}"
                                     YAxes="{Binding RawWaterTurbidityYAxes}"
                                     LegendPosition="Top"
                                     TooltipPosition="Top" 
                                     Margin="2"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
