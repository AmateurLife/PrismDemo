<UserControl x:Class="PrismDemo.B.Views.BHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <StackPanel Margin="16">
        <TextBlock FontSize="16" FontWeight="Bold" Text="模块 B（框架演示，假数据）" Margin="0,0,0,10" />

        <TextBlock Text="配置（读自 b.config.json）：" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding Target, StringFormat='目标值: {0:F1}'}" />
        <TextBlock Text="{Binding TickMs, StringFormat='刷新周期: {0} ms'}" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="启动服务" Width="90" Margin="0,0,8,0" Command="{Binding StartCommand}" />
            <Button Content="停止服务" Width="90" Command="{Binding StopCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding CurrentValue, StringFormat='当前值: {0:F2}'}" FontWeight="Bold" Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Label}" Width="100" />
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:F1}%'}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>