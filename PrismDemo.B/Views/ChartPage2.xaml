<UserControl x:Class="PrismDemo.B.Views.ChartPage2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismDemo.B.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:PrismDemo.Core.Converters;assembly=PrismDemo.Core"
             xmlns:core="clr-namespace:PrismDemo.Core.Services;assembly=PrismDemo.Core"
             xmlns:controls="clr-namespace:PrismDemo.Core.Controls;assembly=PrismDemo.Core"
             xmlns:lvc2="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="960">
    <UserControl.Resources>
        <converters:BoolConverter x:Key="BoolConverter"/>
        <converters:ChangeRateTextConverter x:Key="ChangeRateTextConverter"/>
        <converters:ChangeRateColorConverter x:Key="ChangeRateColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <!-- 关键数据 -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--查看历史曲线按钮-->
                        <Button Grid.ColumnSpan="4" Content="查看详细历史曲线" Command="{Binding OpenHistoryChartCmd}" Height="20"
                                Background="#607D8B" Foreground="White" FontWeight="Bold" FontSize="10"
                                BorderThickness="0" Cursor="Hand" 
                                VerticalAlignment="Top"  HorizontalAlignment="Right"
                                Margin="9,5,5,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <!--智能控制-->
                        <Border Grid.Row="1" Grid.Column="0" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="2号控制点智能控制" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <controls:LedIndicator Grid.Row="1"
                                                       IsAuto="{Binding RingIsAuto}"
                                                       Width="40" Height="40"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!--合规率-->
                        <Border Grid.Row="1" Grid.Column="1" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="合规率" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding ComplianceRate, StringFormat={}{0}%}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding ComplianceRateChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding ComplianceRateChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                        <!--调节池前端B剂浓度-->
                        <Border Grid.Row="1" Grid.Column="2" Margin="5" Padding="12,8"
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" CornerRadius="5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="调节池前端B剂浓度" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#FF9800"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding FrontBResidual, StringFormat={}{0:F2}mg/L}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding FrontBResidualChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding FrontBResidualChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                        <!--调节池后端B剂浓度-->
                        <Border Grid.Row="1" Grid.Column="3" Margin="5" Padding="12,8"
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" CornerRadius="5" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="调节池后端B剂浓度" FontSize="11" Foreground="#888"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#00BCD4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding BackBResidual, StringFormat={}{0:F2}mg/L}"/>
                                <TextBlock Grid.Row="2" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Text="{Binding BackBResidualChange, Converter={StaticResource ChangeRateTextConverter}}"
                                           Foreground="{Binding BackBResidualChange, Converter={StaticResource ChangeRateColorConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!--智能参数区域-->
                <Border Grid.Row="1" Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--B剂浓度目标值-->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B剂浓度目标值" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#388E3C" 
                                       core:WriteableBehavior.IsEnabled="True" 
                                       core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                       core:WriteableBehavior.ConnectData="{Binding CurrentData[FilteredTarget_2_2]}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource BoolConverter}">
                                        <Binding Path="CurrentData[FilteredTarget_2_2].Value"/>
                                        <Binding Path="CurrentData[FilteredTarget_2_2].Type"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="mg/L" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       VerticalAlignment="Center"
                                       Margin="10,0"/>
                        </Grid>
                        <!--投加率人工修正值-->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="投加率人工修正值" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold" 
                                       Foreground="#388E3C" 
                                       core:WriteableBehavior.IsEnabled="True" 
                                       core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                       core:WriteableBehavior.ConnectData="{Binding CurrentData[BUnitRateRatio_2_2]}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource BoolConverter}">
                                        <Binding Path="CurrentData[BUnitRateRatio_2_2].Value"/>
                                        <Binding Path="CurrentData[BUnitRateRatio_2_2].Type"/>
                                    </MultiBinding>
                                </TextBlock.Text></TextBlock>

                            <TextBlock Grid.Column="2" Text="mg/L" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       VerticalAlignment="Center"
                                       Margin="10,0"/>
                        </Grid>
                        <!--投加率上限-->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="投加率上限" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="14" 
                                       FontWeight="Bold" Foreground="#388E3C" 
                                       core:WriteableBehavior.IsEnabled="True" 
                                       core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                       core:WriteableBehavior.ConnectData="{Binding CurrentData[BUnitRate_Upper_2_2]}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource BoolConverter}">
                                        <Binding Path="CurrentData[BUnitRate_Upper_2_2].Value"/>
                                        <Binding Path="CurrentData[BUnitRate_Upper_2_2].Type"/>
                                    </MultiBinding>
                                </TextBlock.Text></TextBlock>


                            <TextBlock Grid.Column="2" Text="mg/L" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       VerticalAlignment="Center"
                                       Margin="10,0"/>
                        </Grid>
                        <!--投加率下限-->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="投加率下限" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="14" 
                                       FontWeight="Bold" Foreground="#388E3C" 
                                       core:WriteableBehavior.IsEnabled="True" 
                                       core:WriteableBehavior.WriteableService="{Binding WriteableService}" 
                                       core:WriteableBehavior.ConnectData="{Binding CurrentData[BUnitRate_Lower_2_2]}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource BoolConverter}">
                                        <Binding Path="CurrentData[BUnitRate_Lower_2_2].Value"/>
                                        <Binding Path="CurrentData[BUnitRate_Lower_2_2].Type"/>
                                    </MultiBinding>
                                </TextBlock.Text></TextBlock>


                            <TextBlock Grid.Column="2" Text="mg/L" FontSize="14" 
                                       FontWeight="SemiBold" Foreground="#555"
                                       VerticalAlignment="Center"
                                       Margin="10,0"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3.25*"/>
                        <RowDefinition Height="6.5*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!--智能药量-->
                    <Border Grid.Row="0" Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="智能药量" FontSize="13" Foreground="#888"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding PredictB, StringFormat={}{0:F2}L/h}"/>
                        </Grid>
                    </Border>
                    <!--实际药量-->
                    <Border Grid.Row="0" Grid.Column="1"  BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="实际药量" FontSize="13" Foreground="#888"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActualB, StringFormat={}{0:F2}L/h}"/>
                        </Grid>
                    </Border>
                    <!--智能投加率-->
                    <Border Grid.Row="0" Grid.Column="2"  BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="智能投加率" FontSize="13" Foreground="#888"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" FontSize="24" FontWeight="Bold" Foreground="#81C784"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding PredictBUnitRate, StringFormat={}{0:F2}L/h}"/>
                        </Grid>
                    </Border>
                    <!-- 七天的调节池前端B剂浓度最大最小平均值的堆叠柱状图 -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="0.5">
                        <lvc2:CartesianChart Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             Series="{Binding TurbidityStackedSeries}"
                                             XAxes="{Binding TurbidityStackedXAxes}"
                                             YAxes="{Binding TurbidityStackedYAxes}"
                                             LegendPosition="Top"
                                             TooltipPosition="Top" 
                                             Margin="2"/>
                    </Border>
                </Grid>
            </Grid>

            <!--动态表格-->
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0.5">
                <DataGrid ItemsSource="{Binding RealtimeDataRows}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeight="22"
                          FontSize="10"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70"/>
                        <DataGridTextColumn Header="前端B剂浓度" Binding="{Binding FrontB, StringFormat={}{0:F3}}" Width="*"/>
                        <DataGridTextColumn Header="后端B剂浓度" Binding="{Binding BackB, StringFormat={}{0:F3}}" Width="*"/>
                        <DataGridTextColumn Header="滤后流量" Binding="{Binding Flow, StringFormat={}{0:F1}}" Width="*"/>
                        <DataGridTextColumn Header="智能药量" Binding="{Binding PredictB, StringFormat={}{0:F2}}" Width="*"/>
                        <DataGridTextColumn Header="实际药量" Binding="{Binding ActualB, StringFormat={}{0:F2}}" Width="*"/>
                        <DataGridTextColumn Header="智能投加率" Binding="{Binding PredictBUnitRate, StringFormat={}{0:F3}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--滤后流量趋势（24小时）-->
            <Border  Grid.Column="0"  BorderBrush="Black" BorderThickness="0.5">
                <lvc2:CartesianChart Grid.Column="0"
                                 Series="{Binding SettledTurbiditySeries}"
                                 XAxes="{Binding SettledTurbidityXAxes}"
                                 YAxes="{Binding SettledTurbidityYAxes}"
                                 LegendPosition="Top"
                                 TooltipPosition="Top" 
                                 Margin="2"/>
            </Border>
            <!--调节池前端B剂浓度趋势（24小时）-->
            <Border  Grid.Column="1"  BorderBrush="Black" BorderThickness="0.5">
                <lvc2:CartesianChart Grid.Column="1"
                                     Series="{Binding RawWaterTurbiditySeries}"
                                     XAxes="{Binding RawWaterTurbidityXAxes}"
                                     YAxes="{Binding RawWaterTurbidityYAxes}"
                                     LegendPosition="Top"
                                     TooltipPosition="Top" 
                                     Margin="2"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
