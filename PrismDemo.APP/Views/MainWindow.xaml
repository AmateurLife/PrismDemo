<Window x:Class="PrismDemo.APP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="540" Width="960" WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="NavBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B3D9F2"/>
            <Setter Property="BorderBrush" Value="#7FB8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7FB8E0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4682B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="14*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="AliceBlue">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <Button Command="{Binding ChangeReportDataCmd}"
                        Width="70" Height="30" Margin="0,0,10,0"
                        Style="{StaticResource NavBarButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xe70d;" Margin="0,0,3,0" 
                                   VerticalAlignment="Center"
                                   FontFamily="/Assets/Fonts/#iconfont"/>
                        <TextBlock Text="报表详情" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ChangeChartPageCmd}"
                        Width="70" Height="30"
                        Style="{StaticResource NavBarButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xe66c;" Margin="0,0,3,0" 
                                   VerticalAlignment="Center"
                                   FontFamily="/Assets/Fonts/#iconfont"/>
                        <TextBlock Text="加药控制" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Command="{Binding ChangeSettingCmd}"
                    Width="50" Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource NavBarButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xe643;" Margin="0,1,3,0" 
                               VerticalAlignment="Center"
                               FontFamily="/Assets/Fonts/#iconfont"/>
                    <TextBlock Text="设置" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1" >
            <Grid  Background="Azure">
                <ContentControl prism:RegionManager.RegionName="ContentRegion" />
            </Grid>
        </Grid>
    </Grid>
</Window>
