<Window x:Class="PrismDemo.APP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="450" Width="760">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button Content="主页" Width="90" Margin="0,0,8,0" Command="{Binding NavigateHomeCommand}" />
            <Button Content="模块 A" Width="90" Margin="0,0,8,0" Command="{Binding NavigateModuleACommand}" />
            <Button Content="模块 B" Width="90" Command="{Binding NavigateModuleBCommand}" />
            <Button Content="设置" Width="90" Margin="8,0,0,0" Command="{Binding NavigateSettingCommand}" />
        </StackPanel>

        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion" />
    </Grid>
</Window>