                                <TextBlock Cursor="Hand" Padding="5,3" FontSize="12">
                                    <Run Text="{Binding AlarmTime, StringFormat='yyyy/M/d HH:mm'}" FontWeight="SemiBold"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding AlarmContent}"
                                         Foreground="{Binding IsChecked, Converter={StaticResource AlarmColorConverter}}"/>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonDown">
