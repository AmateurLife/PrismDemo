                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding ChangeHistoricalAlarmCmd}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AlarmItems}"
