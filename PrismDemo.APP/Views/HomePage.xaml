<UserControl x:Class="PrismDemo.APP.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PrismDemo.APP.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:PrismDemo.APP.Controls"
             xmlns:converters="clr-namespace:PrismDemo.Core.Converters;assembly=PrismDemo.Core"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="960">
    <UserControl.Resources>
        <converters:BoolConverter x:Key="BoolConverter"/>
        <converters:BoolToAlarmColorConverter x:Key="AlarmColorConverter"/>
        <converters:BoolToIconFontConverter x:Key="BoolToIconFont"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:StringToColorConverter x:Key="StringToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 左上：出厂水流量 -->
        <Grid Grid.Column="0" Grid.Row="0">
            <Border BorderBrush="#BBB" BorderThickness="1" Background="#FAFAFA">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="出厂水流量" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 流量卡片 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row0: 进水 / 出厂 -->
                        <Grid Grid.Row="0" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="进水流量" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentInFlow, StringFormat='{}{0:F1}'}" 
                                           FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="#1976D2"/>
                                <TextBlock Text="m³/h" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Fill="#DDD" Width="1"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="出厂水流量" FontSize="10" Foreground="#666" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentOutletFlow, StringFormat='{}{0:F1}'}" 
                                           FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="#388E3C"/>
                                <TextBlock Text="m³/h" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row1: 双向进度条 -->
                        <controls:BidirectionalProgressBar Grid.Row="1" 
                            Ratio="{Binding FlowBalanceRatio}" Margin="10,0"/>

                        <!-- Row2: 变化率 -->
                        <TextBlock Grid.Row="2" Text="{Binding FlowChangeRate}" 
                                   FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2"/>

                        <!-- Row3: 进出水差值迷你曲线 -->
                        <lvc:CartesianChart Grid.Row="3" 
                            Series="{Binding FlowDiffSeries}"
                            XAxes="{Binding FlowDiffXAxes}"
                            AnimationsSpeed="0:0:0"
                            TooltipPosition="Hidden"
                            Margin="0,2"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 左下 -->
        <Grid Grid.Column="0" Grid.Row="1" RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 出厂水B剂浓度 -->
            <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Background="#FAFAFA">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="出厂水B剂浓度" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10">
                        
                        <TextBlock Text="{Binding CurrentB, StringFormat='{}{0:F2}'}" 
                                   FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#1976D2"/>
                        <TextBlock Text="mg/L" FontSize="11" Foreground="#999" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" 
                        Series="{Binding BTrend}"
                        XAxes="{Binding BXAxes}"
                        AnimationsSpeed="0:0:0"
                        TooltipPosition="Hidden"
                        Margin="0,2"/>
                    <TextBlock Grid.Row="3" Text="{Binding BChangeRate}" 
                               FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2"/>
                </Grid>
            </Border>

            <!-- 出厂水浊度 -->
            <Border Grid.Row="1" BorderBrush="#BBB" BorderThickness="1" Background="#FAFAFA">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="出厂水浊度" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="{Binding CurrentTurbidity, StringFormat='{}{0:F2}'}" 
                                   FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#E65100"/>
                        <TextBlock Text="Turbidity" FontSize="11" Foreground="#999" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" 
                        Series="{Binding TurbidityTrend}"
                        XAxes="{Binding TurbidityXAxes}"
                        AnimationsSpeed="0:0:0"
                        TooltipPosition="Hidden"
                        Margin="0,2"/>
                    <TextBlock Grid.Row="3" Text="{Binding TurbidityChangeRate}" 
                               FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,2"/>
                </Grid>
            </Border>
        </Grid>
        <!-- 中上+中中 -->
        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
            <Border BorderBrush="Black" BorderThickness="1">
                <Viewbox Stretch="Uniform">
                    <Grid Width="574" Height="348">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4*"/> 
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">

                        </Grid>
                        <Grid Grid.Row="1">
                            <Border Background="#FAFAFA" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Row="0" Grid.ColumnSpan="7" Background="#E3F2FD" CornerRadius="6,6,0,0">
                                        <TextBlock Text="A剂药泵状态" FontSize="13" FontWeight="Bold" Foreground="#1976D2" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0"/>
                                    </Border>
                                    
                                    <Border Grid.Row="1" Grid.Column="0" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="药泵" FontSize="10" FontWeight="SemiBold" Foreground="#555" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="加药状态" FontSize="9" FontWeight="SemiBold" Foreground="#666" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="0" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="泵后流量(L/h)" FontSize="9" FontWeight="SemiBold" Foreground="#666" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="智能投加率(mg/L)" FontSize="9" FontWeight="SemiBold" Foreground="#666" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="0" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1" CornerRadius="0,0,0,6">
                                        <TextBlock Text="人工投加率(mg/L)" FontSize="9" FontWeight="SemiBold" Foreground="#666" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0"/>
                                    </Border>
                                    
                                    <Border Grid.Row="1" Grid.Column="1" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="1号主泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkMainA_2_1, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="2号备泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkStandbyA_2_2, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="3号主泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkMainA_2_3, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="4" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="4号主泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkMainA_2_4, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="5" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="5号备泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkStandbyA_2_5, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="6" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,0,1" CornerRadius="0,6,0,0">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="6号主泵" FontSize="9" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="&#xe601;" 
                                                       Foreground="{Binding IsWorkMainA_2_6, Converter={StaticResource BoolToColor}}"
                                                       FontFamily="/Assets/Fonts/#iconfont" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <Border Grid.Row="2" Grid.Column="1" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding IsAutoMainA_2_1}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding IsAutoMainA_2_1, Converter={StaticResource StringToColor}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="3" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding IsAutoMainA_2_2}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding IsAutoMainA_2_2, Converter={StaticResource StringToColor}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="4" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding IsAutoMainA_2_3}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding IsAutoMainA_2_3, Converter={StaticResource StringToColor}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="6" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding IsAutoMainA_2_4}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="{Binding IsAutoMainA_2_4, Converter={StaticResource StringToColor}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="2" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="5" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    
                                    <Border Grid.Row="3" Grid.Column="1" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding BackA_1Display}" FontSize="9" FontWeight="Bold" Foreground="#1976D2"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="3" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding BackA_3Display}" FontSize="9" FontWeight="Bold" Foreground="#1976D2"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="4" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding BackA_4Display}" FontSize="9" FontWeight="Bold" Foreground="#1976D2"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="5" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="6" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{Binding BackA_6Display}" FontSize="9" FontWeight="Bold" Foreground="#1976D2"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    
                                    <Border Grid.Row="4" Grid.Column="1" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding PredictMainAUnitRate_2_1}" FontSize="9" FontWeight="Bold" Foreground="#E65100"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="3" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding PredictMainAUnitRate_2_2}" FontSize="9" FontWeight="Bold" Foreground="#E65100"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="4" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding PredictMainAUnitRate_2_3}" FontSize="9" FontWeight="Bold" Foreground="#E65100"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="6" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="{Binding PredictMainAUnitRate_2_4}" FontSize="9" FontWeight="Bold" Foreground="#E65100"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="2" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="5" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    
                                    <Border Grid.Row="5" Grid.Column="1" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,0" CornerRadius="0,0,0,6">
                                        <TextBlock Text="{Binding MainAManualUnitRate_2_1}" FontSize="9" FontWeight="Bold" Foreground="#6A1B9A"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="3" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding MainAManualUnitRate_2_3}" FontSize="9" FontWeight="Bold" Foreground="#6A1B9A"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="4" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding MainAManualUnitRate_2_4}" FontSize="9" FontWeight="Bold" Foreground="#6A1B9A"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="6" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                        <TextBlock Text="{Binding MainAManualUnitRate_2_6}" FontSize="9" FontWeight="Bold" Foreground="#6A1B9A"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="2" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="5" Background="#EEEEEE" BorderBrush="#DDD" BorderThickness="0,0,0,0" CornerRadius="0,0,6,0">
                                        <TextBlock Text="--" FontSize="9" FontWeight="Bold" Foreground="#999"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,4"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
        <!-- 中下：实时数据趋势图 -->
        <Grid Grid.Column="1" Grid.Row="2">
            <Border BorderBrush="#AAA" BorderThickness="1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="实时数据趋势（24小时）" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <lvc:CartesianChart Grid.Row="1"
                        Series="{Binding RealTimeTrend}"
                        XAxes="{Binding RealTimeXAxes}"
                        YAxes="{Binding RealTimeYAxes}"
                        AnimationsSpeed="0:0:0"
                        TooltipPosition="Top"
                        ZoomMode="X"
                        LegendPosition="Top"/>
                </Grid>
            </Border>
        </Grid>
        <!-- 右上：合规率统计图表 -->
        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">
            <Border BorderBrush="Black" BorderThickness="1" Background="Transparent" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.5*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="6*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="建议进水量：" FontSize="14" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="3,0"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,0">
                            <TextBlock Text="19000" 
                                    FontSize="38" FontWeight="Bold" VerticalAlignment="Center"
                                    Foreground="#1976D2"/>
                            <TextBlock Text="m³/h" FontSize="13" Foreground="#999" 
                                       VerticalAlignment="Bottom" Margin="5,30,0,30"/>
                        </StackPanel>
                        <TextBlock Text="可使" FontSize="14" Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="3,0"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="10"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center">
                            <Run Text="调节池"/>
                            <LineBreak/>
                            <Run Text="编号"/>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="1南" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   FontSize="10"/>
                        <TextBlock Grid.Row="2" Text="1北" 
