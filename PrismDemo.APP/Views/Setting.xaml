<UserControl x:Class="PrismDemo.APP.Views.Setting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:PrismDemo.APP.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="8.8*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="3">
            <StackPanel Margin="10">
                <TextBlock Text="设置导航" FontSize="18" Margin="0,0,0,15" />
                <Button Content="模块管理" Command="{Binding NavigateToSectionCommand}" CommandParameter="ModuleSection" Margin="5" Padding="10,5" />
                <Button Content="整系统重载" Command="{Binding NavigateToSectionCommand}" CommandParameter="ReloadSection" Margin="5" Padding="10,5" />
                <Button Content="关于" Command="{Binding NavigateToSectionCommand}" CommandParameter="AboutSection" Margin="5" Padding="10,5" />
                <Button Content="&lt; 返回首页" Command="{Binding ChangeHomePageCmd}" HorizontalAlignment="Left" Margin="5,20,5,5" Padding="10,5" />
            </StackPanel>
        </Border>

        <!-- 右侧内容 -->
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">

                    <!-- 模块管理 -->
                    <StackPanel x:Name="ModuleSection" Margin="0,0,0,32">
                        <TextBlock Text="模块管理" FontSize="20" FontWeight="Bold" />

                        <!-- 导入新模块 -->
                        <GroupBox Header="导入新模块" Margin="0,10,0,12" Padding="10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="模块仓库路径:" VerticalAlignment="Center" Width="100" />
                                    <Button Content="浏览..." Command="{Binding BrowseCommand}" Width="60" Margin="5,0" DockPanel.Dock="Right" />
                                    <TextBox Text="{Binding ModuleSourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="扫描可用模块" Command="{Binding ScanModulesCommand}" Padding="8,4" Margin="0,0,10,0" />
                                    <TextBlock Text="(从仓库路径查找未部署的模块)" VerticalAlignment="Center" Foreground="#666" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DiscoveredModules}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E3F2FD" CornerRadius="4" Padding="12,8" Margin="0,4"
                                                    BorderBrush="#90CAF9" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ModuleName}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Foreground="#666" Margin="10,0" />
                                                    <Button Grid.Column="2" Content="部署"
                                                            Command="{Binding DataContext.DeployModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,2" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- 已部署模块 -->
                        <TextBlock Text="已部署模块" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ReloadStatus}" Foreground="#2196F3" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Visibility="{Binding ReloadStatus, Converter={StaticResource StringToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding AvailableModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0,4" Background="#F5F5F5" CornerRadius="6"
                                            BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="Version: " Foreground="#666666" FontSize="12" />
                                                    <TextBlock Text="{Binding AssemblyVersion}" Foreground="#666666" FontSize="12" />
                                                    <TextBlock Text=" | 部署时间: " Foreground="Gray" FontSize="12" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding DeployTime}" Foreground="Gray" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,2,0,0" Foreground="Gray" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="热重载"
                                                    Command="{Binding DataContext.ReloadModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Padding="12,6" Margin="0,0,8,0"
                                                    Background="#FF9800" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsEnabled}" Width="50" Height="24" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 整系统重载 -->
                    <StackPanel x:Name="ReloadSection" Margin="0,0,0,32">
                        <TextBlock Text="整系统重载" FontSize="20" FontWeight="Bold" />
                        <GroupBox Header="重新加载系统" Margin="0,10,0,0" Padding="12">
                            <StackPanel>
                                <Button Content="重新加载系统" Command="{Binding ReloadSystemCommand}" Padding="14,7"
                                        IsEnabled="{Binding IsReloading, Converter={StaticResource InverseBoolConverter}}"
                                        Background="#2196F3" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" />
                                <TextBlock Text="{Binding SystemReloadStatus}" Foreground="#2196F3" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding SystemReloadStatus, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- 关于 -->
                    <StackPanel x:Name="AboutSection" Margin="0,0,0,32">
                        <TextBlock Text="关于" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="PrismDemo 动态模块化框架演示" TextWrapping="Wrap" Margin="0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="编译时间: " FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BuildTime}" Foreground="#666" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="60" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>