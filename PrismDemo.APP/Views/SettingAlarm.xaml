<UserControl x:Class="PrismDemo.APP.Views.SettingAlarm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismDemo.APP.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:PrismDemo.APP.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="540" d:DesignWidth="960">
    <UserControl.Resources>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：返回按钮、标题、操作按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="&lt; 返回" Command="{Binding GoBackCommand}"
                    Height="28" Width="60" Margin="0,0,10,0"/>
            <TextBlock Text="报警设置" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="50" Margin="0,0,10,0"/>
            <Button Content="+ 新增" Command="{Binding AddCommand}" Width="60" Margin="0,0,10,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Width="50" Background="#4CAF50" Foreground="White"/>
            <Button Content="删除" Command="{Binding DeleteCommand}" Width="50" Background="#F44336" Foreground="White" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- 主体：左侧列表 + 右侧编辑 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 DataGrid -->
            <DataGrid Grid.Column="0" 
                      ItemsSource="{Binding Configs}"
                      SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="数据名" Binding="{Binding ConnectName}" Width="100"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTextColumn Header="等级" Binding="{Binding AlarmLevel}" Width="50"/>
                    <DataGridTextColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD"/>

            <!-- 右侧编辑面板 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" 
                          DataContext="{Binding SelectedConfig}">
                <StackPanel Margin="10,0,10,0">
                    <TextBlock Text="编辑配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                    <!-- 基本信息 -->
                    <GroupBox Header="基本信息" Margin="0,5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="数据名" Margin="0,2"/>
                            <TextBox Text="{Binding ConnectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="名称" Margin="0,2"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="单位" Margin="0,2"/>
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="报警等级 (整数)" Margin="0,2"/>
                            <TextBox Text="{Binding AlarmLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <CheckBox Content="启用" IsChecked="{Binding IsEnabled, Converter={StaticResource IntToBoolConverter}}" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 上限设置 -->
                    <GroupBox Header="上限报警" Margin="0,5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="上限值" Margin="0,2"/>
                            <TextBox Text="{Binding UpperLimit, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="越上限信息" Margin="0,2"/>
                            <TextBox Text="{Binding UpperLimitMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="连续越上限允许时间(秒)" Margin="0,2"/>
                            <TextBox Text="{Binding UpperAllowCount, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 下限设置 -->
                    <GroupBox Header="下限报警" Margin="0,5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="下限值" Margin="0,2"/>
                            <TextBox Text="{Binding LowerLimit, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="越下限信息" Margin="0,2"/>
                            <TextBox Text="{Binding LowerLimitMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="连续越下限允许时间(秒)" Margin="0,2"/>
                            <TextBox Text="{Binding LowerAllowCount, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 突变设置 -->
                    <GroupBox Header="突变报警" Margin="0,5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="突变比值" Margin="0,2"/>
                            <TextBox Text="{Binding MutationThreshold, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="突变报警信息" Margin="0,2"/>
                            <TextBox Text="{Binding MutationThresholdMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="连续突变允许时间(秒)" Margin="0,2"/>
                            <TextBox Text="{Binding MutationAllowCount, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 不变设置 -->
                    <GroupBox Header="长期不变报警" Margin="0,5" Padding="8">
                        <StackPanel>
                            <TextBlock Text="不变报警信息" Margin="0,2"/>
                            <TextBox Text="{Binding UnchangedThresholdMessage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="连续不变允许允许时间(秒)" Margin="0,2"/>
                            <TextBox Text="{Binding UnchangedAllowCount, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </GroupBox>

                    <Rectangle Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
