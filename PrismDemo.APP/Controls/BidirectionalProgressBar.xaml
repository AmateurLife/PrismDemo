<UserControl x:Class="PrismDemo.APP.Controls.BidirectionalProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30">
    <Grid>
        <!-- 背景条 -->
        <Border Background="#E0E0E0" CornerRadius="3"/>
        <!-- 左半部分（红色，向左增长） -->
        <Border x:Name="LeftBar" Background="#F44336" CornerRadius="3,0,0,3"
                HorizontalAlignment="Left" Width="0" MinWidth="0"/>
        <!-- 右半部分（绿色，向右增长） -->
        <Border x:Name="RightBar" Background="#4CAF50" CornerRadius="0,3,3,0"
                HorizontalAlignment="Left" Width="0" MinWidth="0"/>
        <!-- 中心线 -->
        <Rectangle Width="2" Fill="#888" HorizontalAlignment="Center"/>
        <!-- 标签 -->
        <TextBlock x:Name="LabelText" Text="0" HorizontalAlignment="Center" 
                   VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
    </Grid>
</UserControl>
