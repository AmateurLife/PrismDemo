<UserControl x:Class="PrismDemo.Core.Controls.WaterLevel_Arc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismDemo.Core.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="150"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Viewbox Stretch="Uniform">
        <Grid Name="layout" Width="100" Height="100">
            <!-- 背景圆环 -->
            <Ellipse Name="backEllipse" 
                     Stroke="{Binding BackColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                     StrokeThickness="10"/>

            <!-- 液位指示圆弧 -->
            <Path Name="path" 
                  Stroke="{Binding NormalColor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                  StrokeThickness="10" 
                  StrokeStartLineCap="Round" 
                  StrokeEndLineCap="Round"/>

            <!-- 中心数值显示 -->
            <Grid>
                <TextBlock Text="{Binding Value, ElementName=root, StringFormat={}{0:F2}}" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Foreground="{Binding Foreground, ElementName=root}"
                           FontSize="15" 
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding Header, ElementName=root}" 
                           VerticalAlignment="Bottom" 
                           HorizontalAlignment="Center"
                           Foreground="{Binding Foreground, ElementName=root}"
                           FontSize="10" 
                           Margin="0,0,0,15"/>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
